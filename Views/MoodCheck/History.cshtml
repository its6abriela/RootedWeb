@model List<RootedWeb.Models.MoodLog>

@{
    ViewData["Title"] = "Mood History";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.BodyClass = "history-page";
}


<h2 class="mt-4">🧠 Your Mood History</h2>


<!-- Filter historyyyyy-->
<div class="mb-3">
    <form method="get" asp-action="History">
        <label class="me-2 fw-semibold">Filter by:</label>
        <select name="range" onchange="this.form.submit()" class="form-select w-auto d-inline-block">
            <option value="all" selected="@(ViewBag.SelectedRange == "all" ? "selected" : null)">All time</option>
            <option value="week" selected="@(ViewBag.SelectedRange == "week" ? "selected" : null)">Last 7 days</option>
            <option value="month" selected="@(ViewBag.SelectedRange == "month" ? "selected" : null)">This month</option>
        </select>
    </form>
</div>




@if (!Model.Any())
{
    <p>No mood check-ins yet. Try checking in today!</p>
}
else
{
           <!-- mood hisory tableeee-->
    <table class="table mt-3">
        <thead>
            <tr>
                <th>Date</th>
                <th>Mood</th>
                <th>Energy Level</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model)
            {
                <tr>
                    <td>@log.EntryDate.ToString("dd MMM yyyy")</td>
                    <td>@log.Mood</td>
                    <td>@log.EnergyLevel</td>
                </tr>
            }
        </tbody>
    </table>

    <hr />
    <div class="chart-wrapper">
        <!-- mood frequency chart -->
        <h4 class="mt-5">Mood Frequency Overview 📊</h4>
        <canvas id="moodChart" width="400" height="200"></canvas>

        <!-- energy levels chartttttt -->
        <hr />
        <h4 class="mt-5">Energy Level Over Time ⚡</h4>
        <canvas id="energyChart" width="400" height="200"></canvas>
    </div>
}

<div style="height: 200px;"></div> <!-- extra space at the bottom to prevent footer overlap -->
@section Scripts {
    <script>
            // mood chart data
            const moodData = @Html.Raw(Json.Serialize(
        Model.GroupBy(m => m.Mood)
         .Select(g => new { mood = g.Key, count = g.Count() })
    ));

            const labels = moodData.map(m => m.mood);
            const counts = moodData.map(m => m.count);

            new Chart(document.getElementById('moodChart'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Mood Frequency',
                        data: counts,
                        backgroundColor: 'rgba(54, 162, 235, 0.5)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                stepSize: 1
                            }
                        }
                    }
                }
            });

            // energy chart data
            const energyData = @Html.Raw(Json.Serialize(
        Model.OrderBy(m => m.EntryDate)
             .Select(m => new
             {
                 date = m.EntryDate.ToString("MMM dd"),
                 energy = m.EnergyLevel
             })
    ));

            const energyLabels = energyData.map(e => e.date);
            const energyLevels = energyData.map(e => e.energy);

            new Chart(document.getElementById('energyChart'), {
                type: 'line',
                data: {
                    labels: energyLabels,
                    datasets: [{
                        label: 'Energy Level',
                        data: energyLevels,
                        fill: false,
                        borderColor: 'rgba(255, 99, 132, 1)',
                        backgroundColor: 'rgba(255, 99, 132, 0.2)',
                        tension: 0.3,
                        pointRadius: 4
                    }]
                },
                options: {
                    scales: {
                        y: {
                            min: 1,
                            max: 5,
                            ticks: {
                                stepSize: 1
                            }
                        }
                    }
                }
            });
    </script>
}
