@{
    ViewData["Title"] = "Mood Check-In";
}

<h2>Mood Check-In</h2>

<h4 class="mt-4 text-muted fst-italic">
    How are you feeling today?
</h4>


<p>
    <a asp-controller="MoodCheck" asp-action="History" class="btn btn-outline-secondary mt-2">
        View Mood History 📖
    </a>
</p>


<form asp-action="Result" method="post">
    <div class="mb-3">
        
        <div class="d-flex flex-wrap gap-3">

            <input type="hidden" id="selectedMood" name="mood" />

            @foreach (var mood in new[] {
            new { Name = "Awful", Emoji = "🤢" },
            new { Name = "Angry", Emoji = "😠" },
            new { Name = "Anxious", Emoji = "😟" },
            new { Name = "Meh", Emoji = "😐" },
            new { Name = "Tired", Emoji = "😴" },
            new { Name = "Calm", Emoji = "😌" },
            new { Name = "Happy", Emoji = "😊" },
            new { Name = "Focused", Emoji = "🎯" },
            new { Name = "Energetic", Emoji = "⚡" }
            })
            {
                <button type="button" class="btn btn-outline-primary mood-option"
                        data-mood="@mood.Name">
                    <span style="font-size: 1.5rem;">@mood.Emoji</span><br />
                    @mood.Name
                </button>
            }
        </div>
    </div>

    <div class="mb-3">
        <label for="energyLevel" class="form-label">Energy Level (1–5)</label>
        <input type="number" class="form-control" name="energyLevel" min="1" max="5" required />
    </div>

    <button type="submit" class="btn btn-success">Get Motivation</button>
</form>

@section Scripts {
    <script>
        const moodButtons = document.querySelectorAll(".mood-option");
        const moodInput = document.getElementById("selectedMood");

        moodButtons.forEach(button => {
            button.addEventListener("click", () => {
                moodButtons.forEach(b => b.classList.remove("active"));
                button.classList.add("active");
                moodInput.value = button.getAttribute("data-mood");
            });
        });
    </script>
}
