<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rooted</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RootedWeb.styles.css" asp-append-version="true" />
</head>
<body class="@((string)ViewBag.BodyClass ?? "")">

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Rooted</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @if (Context.Session.GetInt32("UserID") != null)
                    {
                        <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark me-5" asp-controller="TaskItems" asp-action="Index">Tasks</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark me-5" asp-controller="MoodCheck" asp-action="Index">Mood Check-In</a>
                        </li>
                        <li class="nav-item">
                                <a class="nav-link text-dark me-5" asp-controller="Garden" asp-action="Index">Mood Garden</a>
                        </li>
                        <li class="nav-item">
                                <a class="nav-link text-dark me-5" asp-controller="Dashboard" asp-action="Index">My Profile</a>
                        </li>
                        <li class="nav-item">
                                <a class="nav-link text-dark me-5 logout-link" asp-controller="User" asp-action="Logout">Logout</a>
                        </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav">
                        <li class="nav-item">
                                <a class="nav-link text-dark me-5" asp-controller="User" asp-action="Login">Login</a>
                        </li>
                        <li class="nav-item">
                                <a class="nav-link text-dark me-5" asp-controller="User" asp-action="Register">Register</a>
                        </li>
                        </ul>
                    }

                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="sticky-footer">
        <div class="footer-grass">
            <p style="color:cornflowerblue ;">© 2025 - Rooted - <a asp-controller="Home" asp-action="Privacy" style="color: cornflowerblue; text-decoration: underline;">Privacy Policy</a></p>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
     <!-- render charts-->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
