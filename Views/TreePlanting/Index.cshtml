@model List<RootedWeb.Models.TreePlanting>
@{
    ViewData["Title"] = "Plant a Tree";
    var isEligible = (bool)(ViewBag.IsEligible ?? false);
    var message = TempData["Message"] as string;
}

<h2 class="mt-4">🌳 Tree Planting</h2>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-success mt-3">
        @message
    </div>
}

@if (isEligible)
{
    <form asp-action="Plant" method="post" class="mt-4">
        <label class="form-label">Choose a region to plant your tree:</label>
        <select name="region" class="form-select w-auto">
            <option value="Amazon Rainforest">Amazon Rainforest</option>
            <option value="Sub-Saharan Africa">Sub-Saharan Africa</option>
            <option value="India">India</option>
            <option value="UK">UK</option>
        </select>
        <button type="submit" class="btn btn-success mt-2">Plant Tree 🌱</button>
    </form>
}
else
{
    <p class="text-muted mt-4">Keep up your streak! You can plant a tree after 30 days of consistent mood check-ins. 🌞</p>
}

<hr class="my-4" />

@if (Model.Any())
{
    <h4>Previously Planted Trees</h4>
    <table class="table mt-3">
        <thead>
            <tr>
                <th>Date Planted</th>
                <th>Region</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tree in Model)
            {
                <tr>
                    <td>@tree.DatePlanted.ToString("dd MMM yyyy")</td>
                    <td>@tree.Region</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>You haven't planted any trees yet.</p>
}
