@model RootedWeb.Models.TaskItem

@{
    ViewData["Title"] = "Create";
}


<h4>Add a new task</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>


            <div class="form-group">
                <label class="control-label">How are you feeling today?</label>
                <div class="d-flex flex-wrap gap-3">

                    <input type="hidden" id="selectedMood" name="Mood" />

                    @foreach (var mood in new[] {
                    new { Name = "Energetic", Emoji = "⚡" },
                    new { Name = "Excited", Emoji = "🤩" },
                    new { Name = "Proud", Emoji = "🏆" },
                    new { Name = "Inspired", Emoji = "✨" },
                    new { Name = "Motivated", Emoji = "🔥" },
                    new { Name = "Happy", Emoji = "😊" },
                    new { Name = "Content", Emoji = "🙂" },
                    new { Name = "Hopeful", Emoji = "🌱" },
                    new { Name = "Focused", Emoji = "🎯" },
                    new { Name = "Calm", Emoji = "😌" },
                    new { Name = "Tired", Emoji = "😴" },
                    new { Name = "Meh", Emoji = "😐" },
                    new { Name = "Anxious", Emoji = "😟" },
                    new { Name = "Frustrated", Emoji = "😤" },
                    new { Name = "Angry", Emoji = "😠" },
                    new { Name = "Sad", Emoji = "😢" },
                    new { Name = "Awful", Emoji = "🤢" }

                    })
                    {
                        <button type="button" class="btn btn-outline-primary mood-option"
                                data-mood="@mood.Name">
                            <span style="font-size: 1.5rem;">@mood.Emoji</span><br />
                            @mood.Name
                        </button>
                    }
                </div>

                <span asp-validation-for="Mood" class="text-danger"></span>
            </div>




            <div class="form-group form-check">
                <label class="form-check-label completed-label">
                    <input class="form-check-input completed-checkbox" asp-for="IsComplete" />
                    <span class="custom-checkmark"></span>
                    Completed
                </label>
            </div>

          <!--  <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
              </div> -->
            <div class="d-flex gap-3 mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-controller="TaskItems" asp-action="Index" class="btn btn-outline-secondary">Back to Task List</a>
            </div>

        </form>
    </div>
</div>

<!--
<div>
    <a asp-controller="TaskItems" asp-action="Index" class="btn btn-outline-secondary">Back to Task List</a>
</div>
-->

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const moodButtons = document.querySelectorAll(".mood-option");
        const moodInput = document.getElementById("selectedMood");

        moodButtons.forEach(button => {
            button.addEventListener("click", () => {
                moodButtons.forEach(b => b.classList.remove("active"));
                button.classList.add("active");
                moodInput.value = button.getAttribute("data-mood");
            });
        });
    </script>
}

