@model IEnumerable<RootedWeb.Models.TaskItem>

@{
    ViewData["Title"] = "Completed Tasks";
}

<h2>Completed Tasks</h2>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Mood</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Mood</td>
                <td>
                    <form asp-action="UndoComplete" asp-route-id="@item.TaskID" method="post" style="display:inline">
                        <button type="submit" class="btn btn-warning btn-sm">Undo</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-outline-primary">← Back to Active Tasks</a>
