@{
    ViewData["Title"] = "Mood Garden";
    var garden = ViewBag.Garden as List<string>;
}


@if (!string.IsNullOrEmpty(ViewBag.StreakMessage))
{
    <div class="alert alert-success text-center" role="alert">
        @ViewBag.StreakMessage
    </div>
}

<!-- tree planting naviagtion-->
<div class="text-center my-4">
    <h4 class="mb-3">Ready to give back to nature?</h4>
    <a class="btn btn-success btn-lg" asp-controller="TreePlanting" asp-action="Index">
        🌍 Plant a Tree🌳 for Your Streak!
    </a>
</div>





<h2 class="mb-4">🌿 Your Mood Garden</h2>

<div class="garden-container mt-4 text-center">
    @if (garden.Count > 0)
    {
        <div class="emoji-garden">
            @foreach (var item in garden)
            {
                <span class="flower">@item</span>
            }
        </div>
    }
    else
    {
        <p class="mt-3">Complete some tasks to grow your garden! 🪴</p>
    }

    <div class="grass-bar"></div>
</div>


<a asp-controller="TaskItems" asp-action="Index" class="btn btn-outline-success">View Tasks</a>

<style>
    @* Razor-safe CSS *@

    .garden-container {
        background: linear-gradient(to top, #a0d995, #d9f2e6);
        border: 2px dashed #70a270;
        border-radius: 20px;
        padding: 40px 20px 80px 20px;
        min-height: 250px;
        position: relative;
    }

    .emoji-garden {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .flower {
        font-size: 2.2rem;
        animation: pop 0.5s ease;
    }

    .grass-bar {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 45px;
        background: linear-gradient(to right, #6dbb64, #77c878);
        border-top: 3px solid #4c8c4a;
        border-radius: 0 0 20px 20px;
        margin: 0;
        padding: 0;
        overflow: visible; /* Allow leaves to stick out */
    }

    /* 🌿 Leaves Styling */
    .leaf {
        position: absolute;
        top: -30px; /* Moves leaves above the grass bar */
        font-size: 1.8rem;
        animation: sway 4s infinite alternate;
    }

    .leaf1 {
        left: 10%;
    }

    .leaf2 {
        left: 30%;
    }

    .leaf3 {
        left: 50%;
    }

    .leaf4 {
        left: 70%;
    }

    .leaf5 {
        left: 90%;
    }

 


    @@keyframes pop {
        0% { transform: scale(0.8);opacity: 0;}

        100% { transform: scale(1); opacity: 1;}

    }
</style>

