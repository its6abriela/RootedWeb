@if (Context.Session.GetString("Username") != null)
{
    <div class="text-center mt-5">

        
        <h1 class="welcome-text">
            Welcome, @Context.Session.GetString("Username")! 🌱
        </h1>

        <p class="lead mt-3">Let’s make today meaningful — your garden is waiting 🌼</p>
        <a asp-controller="TaskItems" asp-action="Index" class="btn btn-success mt-3">Go to My Tasks</a>
    </div>
}
else
{
    <div class="text-center mt-5">
        <h1 class="display-4">Welcome to Rooted 🌿</h1>
        <p class="lead">Check in, feel better, grow your day — one task at a time.</p>
        <a asp-controller="User" asp-action="Login" class="btn btn-outline-success me-2">Login</a>
        <a asp-controller="User" asp-action="Register" class="btn btn-primary">Register</a>
    </div>
}
